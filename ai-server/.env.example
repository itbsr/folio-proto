# Bearer token required in Authorization header.
# Leave blank to disable authentication (dev only).
API_KEY=your-secret-key-here

# Paths to pretrained DewarpNet weights.
# Relative paths are resolved from the directory where you run uvicorn.
WC_MODEL_PATH=./weights/unetnc_doc3d_final.pkl
BM_MODEL_PATH=./weights/dnetccnl_doc3d_final.pkl
